{
  "name": "labsmith-lab-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build && node scripts/write-hosting-files.mts",
    "preview": "wrangler dev",
    "deploy": "SITE_ENV=production npm run build && wrangler deploy",
    "lint": "eslint",
    "validate": "node scripts/validate-catalog.mts",
    "test": "node --test scripts/*.test.mts",
    "extract": "node scripts/extract-lab-metadata.mts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.165.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}

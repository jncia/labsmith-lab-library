{
  "schema": "labpack-site.lab.v1",
  "id": "jncia-practice-1-change-the-router-safely",
  "title": "Change the router safely",
  "summary": "Practise the Junos candidate/active workflow: edit, compare, check, commit, merge a prepared change, and roll back.",
  "prerequisites": null,
  "labType": "build",
  "level": "associate",
  "certifications": [
    "JNCIA-Junos"
  ],
  "topics": [
    "Configuration mode",
    "Candidate and active configuration",
    "Comparing changes",
    "Commit check and commit",
    "Load merge",
    "Rollback"
  ],
  "topicGroups": [
    "config"
  ],
  "estimatedMinutes": 30,
  "stages": [
    {
      "id": "stage-1",
      "title": "Describe the ports",
      "goal": "Label the LAN and provider-facing ports so an operator reading interface output knows what each is for."
    },
    {
      "id": "stage-2",
      "title": "Merge a prepared change",
      "goal": "Predict the result of the workbook's prepared change, then merge it from the terminal, compare, check and commit it. Afterwards, optional rollback practice (lessons 9.3, 9.4) has no check."
    }
  ],

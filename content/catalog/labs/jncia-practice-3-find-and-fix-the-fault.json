  "id": "jncia-practice-3-find-and-fix-the-fault",
  "title": "Find and fix the fault",
  "summary": "Locate two faults on the Lab router from their symptoms, repair them, and prove each repair with show commands, ping and traceroute.",
  "prerequisites": null,
  "labType": "build",
  "level": "associate",
  "certifications": [
    "JNCIA-Junos"
  ],
  "topics": [
    "Troubleshooting method",
    "Interface status",
    "Routing table",
    "Ping",
    "Traceroute",
    "OSPF adjacency"
  ],
  "topicGroups": [
    "ospf",
    "troubleshooting"
  ],
  "estimatedMinutes": 30,
  "stages": [
    {
      "id": "stage-1",
      "title": "The LAN host can't reach its gateway",
      "goal": "Users cannot reach the Lab router. Find why the LAN host gets no answer from its gateway and restore the LAN as designed. Lessons 13.2, 15.3, 16.1, 16.2."
    },
    {
      "id": "stage-2",
      "title": "Nothing beyond the Lab router answers",
      "goal": "The LAN host still cannot reach the Remote network. Find why the Provider side is silent and restore routing to 198.51.100.0/24. Lessons 15.5, 16.5, 16.7, 18.2."
    }
  ],
